{
  "name": "enron",
  "version": "0.0.0",
  "description": "Zero cost scss library",
  "main": "index.scss",
  "sass": "index.scss",
  "files": [
    "enron",
    "index.scss",
    "assets"
  ],
  "private": true,
  "scripts": {
    "dev": "sass index.scss index.css --watch",
    "build": "sass index.scss index.css --no-source-map --fatal-deprecation=1.107.0",
    "build:example": "sass example/main.scss example/main.css --no-source-map --fatal-deprecation=1.107.0",
    "dev:example": "sass example/main.scss example/main.css --watch",
    "test": "sass test/smoke.scss test/smoke.css -I . --no-source-map --fatal-deprecation=1.107.0",
    "clean": "rm -f index.css* test/*.css* example/*.css*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tong/enron.git"
  },
  "author": "tong@disktree.net",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tong/enron/issues"
  },
  "homepage": "https://github.com/tong/enron#readme",
  "devDependencies": {
    "sass": "^1.107.0"
  }
}
