{
    "name": "enron",
    "version": "0.0.0",
    "description": "Zero cost scss library",
    "main": "index.scss",
    "private": true,
    "scripts": {
        "dev": "sass index.scss index.css --watch",
        "build:test": "sass test/main.scss test/main.css -I .",
        "build": "sass index.scss index.css --no-source-map",
        "clean": "rm -f index.css* test.css*"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tong/enron.git"
    },
    "author": "tong@disktree.net",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/tong/enron/issues"
    },
    "homepage": "https://github.com/tong/enron#readme",
    "devDependencies": {
        "sass": "^1.62.1"
    }
}
